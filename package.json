{
  "name": "classroom-clock",
  "productName": "우리반 시계",
  "version": "0.1.0",
  "description": "교실 듀얼 모니터용 일정 안내 위젯",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/make-icons.cjs",
    "dist": "electron-vite build && electron-builder --win nsis portable",
    "dist:dir": "electron-vite build && electron-builder --win --dir",
    "release": "electron-vite build && electron-builder --win nsis portable --publish always"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "koffi": "^3.3.2"
  },
  "devDependencies": {
    "@fontsource/jua": "^5.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  },
  "author": "우리반 시계",
  "build": {
    "appId": "kr.classroom.clock",
    "productName": "우리반 시계",
    "copyright": "우리반 시계",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/tray.png",
        "to": "tray.png"
      }
    ],
    "asarUnpack": [
      "node_modules/koffi/**",
      "node_modules/@koromix/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "우리반 시계",
      "artifactName": "ClassroomClock-Setup.${ext}"
    },
    "portable": {
      "artifactName": "ClassroomClock-portable.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "seoseo1234",
        "repo": "scheduler",
        "releaseType": "release"
      }
    ]
  }
}
